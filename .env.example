# GEMINI_API_KEY: Required only if Gemini AI features are added server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_DEFAULT_SPREADSHEET_ID: Optional default Google Spreadsheet ID for Vercel deployment.
# If left empty, users can connect or create a spreadsheet directly from the CendekiaEdu UI.
VITE_DEFAULT_SPREADSHEET_ID=""
